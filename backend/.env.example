# Daml JSON API (default: http://127.0.0.1:7575)
# DAML_JSON_API_URL=http://127.0.0.1:7575

# Server port (default: 4000)
# PORT=4000

# MongoDB – app user list and other app data (default: mongodb://localhost:27017/create-daml-app)
# Start MongoDB first: run `mongod` (or `brew services start mongodb-community` on macOS).
# Then either leave unset to use the default, or set for a custom host/port/database:
# MONGODB_URI=mongodb://localhost:27017/create-daml-app
# MONGODB_URI=mongodb://user:password@host:27017/create-daml-app

# Optional: override package ID if your DAR has a different one after daml build
# DAML_PACKAGE_ID=ce2f082762ae6c6ff33d5a7c2dcdce9a149f5f891bab9fe90a54f90d5bc6834b
