-- | Bank module: Factory (bank creates accounts), Account (deposits, withdrawals,
-- | peer transfers via TransferRequest), and Transaction (audit trail).
module Bank where

import DA.Optional (fromSomeNote)
import qualified DA.Text as T

-- | Per-customer message from the bank when an operation completes (deposit, transfer, etc.).
-- | The UI formats `category`, `amount`, `balanceAfter`, and `counterparty` into readable text.
template BankCustomerNotification with
    bank : Party
    recipient : Party
    category : Text
    amount : Decimal
    balanceAfter : Optional Decimal
    counterparty : Optional Party
    createdAt : Time
  where
    signatory bank
    observer recipient

-- | Immutable notice on the ledger. The bank publishes updates via `Factory.PublishBankNotice`
-- | (nonconsuming); the UI shows the latest by `publishedAt`.
template BankNotice with
    bank : Party
    public : Party
    message : Text
    publishedAt : Time
  where
    signatory bank
    observer public

-- | Bank authority: can create accounts and perform bank-to-bank transfers.
template Factory with
    bank : Party
    public : Party
  where
    signatory bank
    observer public

    nonconsuming choice CreateAccount : ContractId Account with
        owner : Party
      controller bank
      do
        create Account with
          bank = bank
          owner = owner
          balance = 0.0
          following = []

    nonconsuming choice PublishBankNotice : () with
        newMessage : Text
      controller bank
      do
        now <- getTime
        assertMsg "Message too long" (T.length newMessage <= 2000)
        _ <- create BankNotice with
          bank = bank
          public = public
          message = newMessage
          publishedAt = now
        return ()

    nonconsuming choice BankTransfer : () with
        fromOwner : Party
        toOwner : Party
        amount : Decimal
      controller bank
      do
        now <- getTime
        fromOpt <- lookupByKey @Account (bank, fromOwner)
        toOpt <- lookupByKey @Account (bank, toOwner)
        let fromCid = fromSomeNote "From account not found" fromOpt
        let toCid = fromSomeNote "To account not found" toOpt
        fromAccount <- fetch fromCid
        toAccount <- fetch toCid
        assertMsg "Amount must be positive" (amount > 0.0)
        assertMsg "Cannot transfer to self" (fromOwner /= toOwner)
        assertMsg "Insufficient balance" (fromAccount.balance >= amount)
        let fromNewBal = fromAccount.balance - amount
        let toNewBal = toAccount.balance + amount
        archive fromCid
        create fromAccount with balance = fromNewBal
        archive toCid
        create toAccount with balance = toNewBal
        create Transaction with
          bank = bank
          owner = fromOwner
          amount = -amount
          transactionType = "BankTransfer"
          counterparty = Some toOwner
          createdAt = now
        create Transaction with
          bank = bank
          owner = toOwner
          amount = amount
          transactionType = "BankTransfer"
          counterparty = Some fromOwner
          createdAt = now
        _ <- create BankCustomerNotification with
          bank = bank
          recipient = fromOwner
          category = "BankTransferOut"
          amount = amount
          balanceAfter = Some fromNewBal
          counterparty = Some toOwner
          createdAt = now
        _ <- create BankCustomerNotification with
          bank = bank
          recipient = toOwner
          category = "BankTransferIn"
          amount = amount
          balanceAfter = Some toNewBal
          counterparty = Some fromOwner
          createdAt = now
        pure ()

-- | Immutable audit record for an account movement.
template Transaction with
    bank : Party
    owner : Party
    amount : Decimal
    transactionType : Text
    counterparty : Optional Party
    createdAt : Time
  where
    signatory bank
    observer owner

-- | Customer account at the bank: balance and list of parties they can transfer to.
template Account with
    bank : Party
    owner : Party
    balance : Decimal
    following : [Party]
  where
    signatory bank
    observer owner

    key (bank, owner) : (Party, Party)
    maintainer key._1

    ensure balance >= 0.0

    nonconsuming choice Deposit : ContractId Account with
        amount : Decimal
      controller owner
      do
        assertMsg "Amount must be positive" (amount > 0.0)
        now <- getTime
        let newBalance = balance + amount
        create Transaction with
          bank = bank
          owner = owner
          amount = amount
          transactionType = "Deposit"
          counterparty = None
          createdAt = now
        _ <- create BankCustomerNotification with
          bank = bank
          recipient = owner
          category = "Deposit"
          amount = amount
          balanceAfter = Some newBalance
          counterparty = None
          createdAt = now
        archive self
        create this with balance = newBalance

    nonconsuming choice Withdraw : ContractId Account with
        amount : Decimal
      controller owner
      do
        assertMsg "Amount must be positive" (amount > 0.0)
        assertMsg "Insufficient balance" (balance >= amount)
        now <- getTime
        let newBalance = balance - amount
        create Transaction with
          bank = bank
          owner = owner
          amount = -amount
          transactionType = "Withdraw"
          counterparty = None
          createdAt = now
        _ <- create BankCustomerNotification with
          bank = bank
          recipient = owner
          category = "Withdraw"
          amount = amount
          balanceAfter = Some newBalance
          counterparty = None
          createdAt = now
        archive self
        create this with balance = newBalance

    nonconsuming choice CreateTransferRequest : ContractId TransferRequest with
        recipient : Party
        amount : Decimal
        isBillPayment : Bool
      controller owner
      do
        assertMsg "Amount must be positive" (amount > 0.0)
        assertMsg "Insufficient balance" (balance >= amount)
        assertMsg "Cannot transfer to yourself" (recipient /= owner)
        assertMsg "Can only transfer to users you follow" (elem recipient following)
        create TransferRequest with
          sender = owner
          recipient = recipient
          amount = amount
          bank = bank
          isBillPayment = isBillPayment

    nonconsuming choice UpdateFollowing : ContractId Account with
        newFollowing : [Party]
      controller owner
      do
        archive self
        create this with following = newFollowing

-- | Request from sender to transfer amount to recipient; bank exercises ExecuteTransfer.
template TransferRequest with
    sender : Party
    recipient : Party
    amount : Decimal
    bank : Party
    isBillPayment : Bool
  where
    signatory sender
    observer bank

    ensure amount > 0.0

    nonconsuming choice ExecuteTransfer : () with
      controller bank
      do
        now <- getTime
        senderOpt <- lookupByKey @Account (bank, sender)
        recipientOpt <- lookupByKey @Account (bank, recipient)
        let senderCid = fromSomeNote "Sender account not found" senderOpt
        let recipientCid = fromSomeNote "Recipient account not found" recipientOpt
        assertMsg "Cannot transfer to the same account" (senderCid /= recipientCid)
        senderAccount <- fetch senderCid
        recipientAccount <- fetch recipientCid
        assertMsg "Sender must match" (senderAccount.owner == sender)
        assertMsg "Recipient must match" (recipientAccount.owner == recipient)
        assertMsg "Can only transfer to users sender follows" (elem recipient senderAccount.following)
        assertMsg "Insufficient balance" (senderAccount.balance >= amount)
        let senderNewBal = senderAccount.balance - amount
        let recipientNewBal = recipientAccount.balance + amount
        archive senderCid
        create senderAccount with balance = senderNewBal
        archive recipientCid
        create recipientAccount with balance = recipientNewBal
        create Transaction with
          bank = bank
          owner = sender
          amount = -amount
          transactionType = "Transfer"
          counterparty = Some recipient
          createdAt = now
        create Transaction with
          bank = bank
          owner = recipient
          amount = amount
          transactionType = "Transfer"
          counterparty = Some sender
          createdAt = now
        if isBillPayment
          then do
            _ <- create BankCustomerNotification with
              bank = bank
              recipient = sender
              category = "BillPayment"
              amount = amount
              balanceAfter = None
              counterparty = Some recipient
              createdAt = now
            _ <- create BankCustomerNotification with
              bank = bank
              recipient = recipient
              category = "TransferIn"
              amount = amount
              balanceAfter = Some recipientNewBal
              counterparty = Some sender
              createdAt = now
            pure ()
          else do
            _ <- create BankCustomerNotification with
              bank = bank
              recipient = sender
              category = "TransferOut"
              amount = amount
              balanceAfter = Some senderNewBal
              counterparty = Some recipient
              createdAt = now
            _ <- create BankCustomerNotification with
              bank = bank
              recipient = recipient
              category = "TransferIn"
              amount = amount
              balanceAfter = Some recipientNewBal
              counterparty = Some sender
              createdAt = now
            pure ()

    choice Complete : () with
      controller bank
      do
        archive self
        pure ()

-- | Request from creditor to be paid by payer. Creditor creates it; payer pays by doing a
-- | normal transfer (CreateTransferRequest on their account, then bank ExecuteTransfer).
-- | No Pay choice on this contract — paying reuses the existing transfer flow.
template PaymentRequest with
    creditor : Party
    payer : Party
    amount : Decimal
    bank : Party
    message : Optional Text
    requestId : Text
  where
    signatory creditor
    observer payer

    key (creditor, requestId) : (Party, Text)
    maintainer key._1

    ensure amount > 0.0

    choice Cancel : () with
      controller creditor
      do
        archive self
        pure ()

    choice Decline : () with
      controller payer
      do
        archive self
        pure ()

    choice MarkPaid : () with
      controller payer
      do
        archive self
        pure ()
